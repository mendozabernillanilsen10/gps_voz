<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Incluir configuraciones importantes -->
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />

    <!-- Excluir archivos sensibles de operaciones -->
    <exclude domain="file" path="voice_recordings/" />
    <exclude domain="file" path="emergency/" />
    <exclude domain="file" path="temp/" />

    <!-- Excluir cache temporal -->
    <exclude domain="file" path="cache/" />
</full-backup-content>