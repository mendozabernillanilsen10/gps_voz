{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid"
      }
    },
    
    "proximity_chats": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$chatId": {
        ".validate": "newData.hasChildren(['creatorId', 'title', 'latitude', 'longitude', 'pin'])"
      }
    },
    
    "chat_messages": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$messageId": {
          ".validate": "newData.hasChildren(['userId', 'content', 'timestamp'])"
        }
      }
    },
    
    "chat_participants": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    
    "user_locations": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    
    "webrtc_calls": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$callId": {
        ".validate": "newData.hasChildren(['chatId', 'callType', 'initiatorId', 'timestamp'])"
      }
    },
    
    "webrtc_signals": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "chat_notifications": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    
    "fcm_tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    
    "notification_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "error_logs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    
    "group_calls": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$callId": {
        ".validate": "newData.hasChildren(['chatId', 'callType', 'initiatorId', 'timestamp', 'status'])"
      }
    }
  }
} 